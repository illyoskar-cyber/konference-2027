---
import { tinaField } from '@tinacms/astro/tina-field';
import PageHead from './PageHead.astro';
import type { SiteProgram } from '../../lib/site-data';

interface Props {
	data?: SiteProgram | null;
}

const { data } = Astro.props;
const days = (data?.days ?? []).filter((day) => day != null);

const asideClass = 'mt-[18px] border-t border-dashed border-line py-2.5 text-[0.9rem] text-muted italic';
---

{
	data && (
		<>
			<PageHead data={data} />

			{days.map((day) => (
				<section data-tina-field={tinaField(day)} class="mb-16">
					<div class="mb-7 flex flex-wrap items-baseline justify-between gap-2.5 border-b-2 border-line pb-4">
						<h2 data-tina-field={tinaField(day, 'name')} class="text-2xl font-semibold">
							{day.name}
						</h2>
						{day.theme && (
							<div data-tina-field={tinaField(day, 'theme')} class="text-[0.95rem] font-semibold text-v2">
								{day.theme}
							</div>
						)}
						{day.moderators && (
							<div data-tina-field={tinaField(day, 'moderators')} class="w-full text-[0.85rem] text-muted">
								{day.moderators}
							</div>
						)}
					</div>

					{(day.items ?? []).map((item) => {
						if (item?.__typename === 'StrankyProgramDaysItemsAside') {
							return (
								<div data-tina-field={tinaField(item, 'text')} class={asideClass}>
									{item.text}
								</div>
							);
						}
						if (item?.__typename !== 'StrankyProgramDaysItemsBlock') return null;
						const talks = (item.talks ?? []).filter((talk) => talk != null);
						return (
							<div data-tina-field={tinaField(item)} class="mb-9">
								<div class="mb-4 flex flex-wrap items-baseline gap-3.5">
									{item.time && (
										<span
											data-tina-field={tinaField(item, 'time')}
											class="rounded-md bg-v1/8 px-2.5 py-[3px] font-display font-semibold text-v1"
										>
											{item.time}
										</span>
									)}
									<h3 data-tina-field={tinaField(item, 'title')} class="font-sans text-[1.15rem] font-semibold">
										{item.title}
									</h3>
									{item.tag && (
										<span data-tina-field={tinaField(item, 'tag')} class="text-[0.8rem] text-muted italic">
											{item.tag}
										</span>
									)}
								</div>
								<div class="grid gap-4 md:grid-cols-2">
									{talks.map((talk) => (
										<div data-tina-field={tinaField(talk)} class="rounded-[10px] border border-line bg-surface px-[18px] py-4">
											<h4 data-tina-field={tinaField(talk, 'title')} class="mb-[3px] text-[0.98rem] font-semibold">
												{talk.title}
											</h4>
											{talk.presenter && (
												<div data-tina-field={tinaField(talk, 'presenter')} class="mb-1.5 text-[0.82rem] font-semibold text-v2">
													{talk.presenter}
												</div>
											)}
											{talk.desc && (
												<p data-tina-field={tinaField(talk, 'desc')} class="text-[0.88rem] whitespace-pre-line text-muted">
													{talk.desc}
												</p>
											)}
										</div>
									))}
								</div>
								{item.aside && (
									<div data-tina-field={tinaField(item, 'aside')} class={asideClass}>
										{item.aside}
									</div>
								)}
							</div>
						);
					})}
				</section>
			))}
		</>
	)
}
