---
import { tinaField } from '@tinacms/astro/tina-field';

interface Props {
	/** Texts from a Tina document (click-to-edit) or a plain object. */
	data: { tag?: string | null; title?: string | null; intro?: string | null };
}

const { data } = Astro.props;
---

<div class="mb-11 max-w-[640px]">
	{
		data.tag && (
			<span data-tina-field={tinaField(data, 'tag')} class="mb-3 block text-[0.92rem] font-semibold text-v2">
				{data.tag}
			</span>
		)
	}
	<h1 data-tina-field={tinaField(data, 'title')} class="text-[2.2rem] font-semibold">{data.title}</h1>
	{
		data.intro && (
			<p data-tina-field={tinaField(data, 'intro')} class="mt-3.5 text-[1.02rem] whitespace-pre-line text-muted">
				{data.intro}
			</p>
		)
	}
</div>
