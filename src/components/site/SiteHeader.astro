---
import { tinaField } from '@tinacms/astro/tina-field';
import type { SiteNastaveni } from '../../lib/site-data';
import { href, linkHref } from '../../lib/site';

interface Props {
	data?: SiteNastaveni | null;
	/** Path of the current page, for highlighting the active menu item. */
	current: string;
}

const { data, current } = Astro.props;
const header = data?.header;
const normalize = (path: string) => path.replace(/\/$/, '');
// Only menu items switched on in the CMS are shown.
const nav = (header?.nav ?? []).flatMap((item) => {
	if (!item?.active) return [];
	const target = linkHref(item);
	return [{ item, target, current: normalize(target) === normalize(current) }];
});
---

<header
	class="relative z-2 flex flex-wrap items-center justify-between gap-5 border-b border-line bg-surface/85 px-[6vw] py-6 backdrop-blur-[6px]"
>
	<a href={href()} data-tina-field={header ? tinaField(header, 'name') : undefined} class="max-w-80 font-semibold">
		{header?.name}
		{
			header?.tagline && (
				<small data-tina-field={tinaField(header, 'tagline')} class="mt-[3px] block text-[0.82em] font-normal text-muted">
					{header.tagline}
				</small>
			)
		}
	</a>

	<!-- Desktop menu -->
	<nav class="hidden flex-wrap items-center gap-4 text-[0.88rem] nav:flex md:gap-6 md:text-[0.93rem]">
		{
			nav.map(({ item, target, current }) => (
				<a
					href={target}
					aria-current={current ? 'page' : undefined}
					data-tina-field={tinaField(item)}
					class="border-b border-transparent pb-[3px] text-muted transition-colors hover:border-v2 hover:text-ink aria-[current=page]:border-v2 aria-[current=page]:text-ink"
				>
					{item.label}
				</a>
			))
		}
	</nav>

	<!-- Mobile menu: hamburger opening an off-canvas panel -->
	<button
		type="button"
		data-menu-open
		aria-label="Otevřít menu"
		aria-haspopup="dialog"
		aria-controls="mobile-menu"
		class="-mr-2 cursor-pointer rounded-lg p-2 text-ink transition-colors hover:text-v2 nav:hidden"
	>
		<svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
			<path d="M4 6h16M4 12h16M4 18h16"></path>
		</svg>
	</button>

	<dialog
		id="mobile-menu"
		aria-label="Menu"
		class="my-0 mr-0 ml-auto h-dvh max-h-none w-[min(80vw,320px)] translate-x-full bg-surface p-0 text-ink shadow-hero transition-[translate,display,overlay] transition-discrete duration-200 backdrop:bg-ink/40 open:translate-x-0 starting:open:translate-x-full"
	>
		<div class="flex h-full flex-col px-6 pt-5 pb-8">
			<button
				type="button"
				data-menu-close
				aria-label="Zavřít menu"
				class="-mr-2 cursor-pointer self-end rounded-lg p-2 text-muted transition-colors hover:text-ink"
			>
				<svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
			<nav class="mt-4 flex flex-col">
				{
					nav.map(({ item, target, current }) => (
						<a
							href={target}
							aria-current={current ? 'page' : undefined}
							data-tina-field={tinaField(item)}
							class="border-b border-line py-3.5 text-[1.05rem] text-muted transition-colors first:border-t hover:text-ink aria-[current=page]:font-semibold aria-[current=page]:text-v2"
						>
							{item.label}
						</a>
					))
				}
			</nav>
		</div>
	</dialog>
</header>

<script>
	// Delegated, so the menu keeps working after the admin preview re-renders the header.
	const menu = () => document.querySelector<HTMLDialogElement>('#mobile-menu');

	document.addEventListener('click', (e) => {
		const target = e.target as Element;
		if (target.closest('[data-menu-open]')) menu()?.showModal();
		if (target.closest('[data-menu-close]')) menu()?.close();
		// A click on the backdrop lands on the <dialog> itself.
		if (target.id === 'mobile-menu') menu()?.close();
	});

	// Close the panel when the window grows to the desktop layout.
	matchMedia('(min-width: 48rem)').addEventListener('change', (e) => {
		if (e.matches) menu()?.close();
	});
</script>
