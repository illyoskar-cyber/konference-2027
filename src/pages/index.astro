---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import UvodBody from '../components/site/UvodBody.astro';
import { asPage, getStranka } from '../lib/site-data';
import { islands } from '../lib/islands';

const data = asPage((await getStranka('uvod')).data?.stranky, 'StrankyUvod');
if (!data) return new Response('Not Found', { status: 404 });
---

<SiteLayout fullTitle={data.seo?.title || undefined} description={data.seo?.description || undefined}>
	<TinaIsland name="site-uvod" wrapper={islands['site-uvod'].wrapper} primary>
		<UvodBody data={data} />
	</TinaIsland>
</SiteLayout>
