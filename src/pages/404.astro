---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHead from '../components/site/PageHead.astro';
import { href } from '../lib/site';
---

<SiteLayout title="Stránka nenalezena" page>
	<PageHead
		data={{ tag: 'Chyba 404', title: 'Stránka nenalezena', intro: 'Tahle stránka neexistuje nebo byla přesunuta.' }}
	/>
	<a
		href={href()}
		class="inline-block rounded-lg bg-linear-120/srgb from-v1 to-v2 px-[22px] py-3 text-[0.92rem] font-semibold text-on-accent shadow-accent transition-transform hover:-translate-y-px"
	>
		Zpět na úvod
	</a>
</SiteLayout>
