---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import KontaktBody from '../components/site/KontaktBody.astro';
import { asPage, getStranka } from '../lib/site-data';
import { islands } from '../lib/islands';

const data = asPage((await getStranka('kontakt')).data?.stranky, 'StrankyKontakt');
if (!data) return new Response('Not Found', { status: 404 });
---

<SiteLayout title={data.seo?.title || data.title} description={data.seo?.description || undefined} page>
	<TinaIsland name="site-kontakt" wrapper={islands['site-kontakt'].wrapper} primary>
		<KontaktBody data={data} />
	</TinaIsland>
</SiteLayout>
