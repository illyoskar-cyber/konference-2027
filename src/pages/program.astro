---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProgramBody from '../components/site/ProgramBody.astro';
import { asPage, getStranka } from '../lib/site-data';
import { islands } from '../lib/islands';

const data = asPage((await getStranka('program')).data?.stranky, 'StrankyProgram');
if (!data) return new Response('Not Found', { status: 404 });
---

<SiteLayout title={data.seo?.title || data.title} description={data.seo?.description || undefined} page>
	<TinaIsland name="site-program" wrapper={islands['site-program'].wrapper} primary>
		<ProgramBody data={data} />
	</TinaIsland>
</SiteLayout>
