# Produkční adresa webu (sitemap, canonical, OpenGraph). Na Netlify je
# nepovinná – bez ní se použije adresa, kterou dodá Netlify.
SITE_URL=https://example.com

# Z projektu v TinaCloud (app.tina.io). Potřebuje je `npm run build`;
# `npm run dev` a `npm run build:local` běží i bez nich.
PUBLIC_TINA_CLIENT_ID=***
TINA_TOKEN=***
